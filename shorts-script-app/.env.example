# 필수: Claude API 키 (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# 필수: YouTube Data API v3 키 (Google Cloud Console > API 및 서비스)
YOUTUBE_API_KEY=

# 선택: 네이버 검색 API (블로그/카페 반응 수집) https://developers.naver.com
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 선택: 사용할 Claude 모델 (기본 claude-opus-5-5)
CLAUDE_MODEL=claude-opus-5-5
# 선택: 데이터 파일 경로
DB_PATH=data/shorts.db
# 선택: 자동 수집 주기(시간). 0이면 끔. 키워드는 쉼표로 구분
AUTO_COLLECT_HOURS=0
AUTO_COLLECT_KEYWORDS=리뷰,언박싱,가성비,추천템
